# SkyCAIR OS — Ollama AMD ROCm Configuration
# Overlays /etc/ollama/ollama.env from 003-skyomegai base module

OLLAMA_HOST=0.0.0.0:11434

# AMD ROCm backend
OLLAMA_GPU=rocm

# AMD GPU device selection
HIP_VISIBLE_DEVICES=0

# ROCm BLAS library path
OLLAMA_ROCM_OVERRIDE_GFX_VERSION=

# Model storage
OLLAMA_MODELS=/skycair/ai/models

# ROCm performance
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_FLASH_ATTENTION=1

OLLAMA_KEEP_ALIVE=10m
OLLAMA_DEBUG=0
