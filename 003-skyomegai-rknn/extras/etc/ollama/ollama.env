# SkyCAIR OS — Ollama RKNN/NPU Configuration
# Overlays /etc/ollama/ollama.env from 003-skyomegai base module

OLLAMA_HOST=0.0.0.0:11434

# RKNN NPU backend (via llama.cpp RKNN backend)
OLLAMA_GPU=rknn

# llama.cpp RKNN library path
OLLAMA_LLM_LIBRARY=/opt/llama-rknn/lib

# NPU core assignment: -1=auto, 0/1/2=specific core (RK3588 has 3 NPU cores)
RKLLM_NPU_CORE=-1
RKLLM_THREAD_NUM=4

# Model storage
OLLAMA_MODELS=/skycair/ai/models

# NPU inference settings (RK3588 — 6 TOPS, 4GB NPU SRAM shared with main RAM)
# Recommended models for RK3588: 1.5B–7B quantized (Q4_K_M)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0

# Keep model in NPU SRAM between requests
OLLAMA_KEEP_ALIVE=15m

RKNN_LOG_LEVEL=0
OLLAMA_DEBUG=0
