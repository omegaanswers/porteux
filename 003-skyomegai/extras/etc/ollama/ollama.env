# SkyCAIR OS — Ollama Service Environment
# Sourced by rc.ollama at boot
# Hardware acceleration is set by the accelerator sub-module:
#   003-skyomegai-nvidia.xzm overrides OLLAMA_GPU=cuda
#   003-skyomegai-amd.xzm    overrides OLLAMA_GPU=rocm
#   003-skyomegai-rknn.xzm   overrides OLLAMA_GPU=rknn

# API bind address
OLLAMA_HOST=0.0.0.0:11434

# GPU backend — overridden by accelerator module overlay
# Values: cpu | cuda | rocm | rknn | metal
OLLAMA_GPU=cpu

# Model storage (persistent on SkyFILES partition)
OLLAMA_MODELS=/skycair/ai/models

# Max concurrent requests
OLLAMA_NUM_PARALLEL=1

# Max loaded models in memory
OLLAMA_MAX_LOADED_MODELS=1

# Flash attention (performance — enable if supported by GPU)
OLLAMA_FLASH_ATTENTION=0

# Verbose logging (set to 1 for debugging)
OLLAMA_DEBUG=0

# Keep model loaded in memory for N seconds after last use (0=unload immediately)
OLLAMA_KEEP_ALIVE=5m
