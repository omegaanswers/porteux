# SkyCAIR OS — Ollama NVIDIA CUDA Configuration
# Overlays /etc/ollama/ollama.env from 003-skyomegai base module

OLLAMA_HOST=0.0.0.0:11434

# NVIDIA CUDA backend — enables GPU inference
OLLAMA_GPU=cuda

# CUDA device selection (0=first GPU, 0,1=multi-GPU)
CUDA_VISIBLE_DEVICES=0

# Model storage
OLLAMA_MODELS=/skycair/ai/models

# CUDA performance settings
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_FLASH_ATTENTION=1

# VRAM management — free GPU memory after model unload
OLLAMA_GPU_MEMORY_FRACTION=0.85

# Keep model hot for 10 minutes (NVIDIA has fast reload from VRAM)
OLLAMA_KEEP_ALIVE=10m

OLLAMA_DEBUG=0
